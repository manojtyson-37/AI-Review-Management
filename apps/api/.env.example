DATABASE_URL=postgresql://reviewassist:password@localhost:5432/reviewassist
JWT_SECRET=                      # required, no default. e.g. openssl rand -base64 48
TOKEN_ENCRYPTION_KEY=            # required. 32 random bytes, base64: openssl rand -base64 32
OPENAI_API_KEY=
FRONTEND_URL=http://localhost:3000

# Google OAuth client (one client, two redirect URIs registered)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_LOGIN_CALLBACK_URL=http://localhost:3001/auth/google/callback
GOOGLE_BUSINESS_REDIRECT_URI=http://localhost:3001/integrations/google/callback
